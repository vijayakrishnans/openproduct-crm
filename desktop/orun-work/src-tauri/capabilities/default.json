{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the editor window may do. It can start one program, orun, with any arguments; read files (never write them); open a folder picker; and make HTTPS requests to the Anthropic API.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }] },
    "shell:allow-open",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "orun", "cmd": "orun", "args": true }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.anthropic.com/*" }]
    }
  ]
}
