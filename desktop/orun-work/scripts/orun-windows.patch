diff --git a/cmd/orun/command_run_background_unix.go b/cmd/orun/command_run_background_unix.go
new file mode 100644
index 0000000..5268237
--- /dev/null
+++ b/cmd/orun/command_run_background_unix.go
@@ -0,0 +1,13 @@
+//go:build !windows
+
+package main
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+// detachBackground puts a background run in its own process group.
+func detachBackground(cmd *exec.Cmd) {
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+}
diff --git a/cmd/orun/command_run_background_windows.go b/cmd/orun/command_run_background_windows.go
new file mode 100644
index 0000000..f3940f0
--- /dev/null
+++ b/cmd/orun/command_run_background_windows.go
@@ -0,0 +1,16 @@
+//go:build windows
+
+package main
+
+import (
+	"os/exec"
+	"syscall"
+)
+
+// detachBackground starts a background run in a new process group, without
+// a console window.
+func detachBackground(cmd *exec.Cmd) {
+	const createNewProcessGroup = 0x00000200
+	const createNoWindow = 0x08000000
+	cmd.SysProcAttr = &syscall.SysProcAttr{CreationFlags: createNewProcessGroup | createNoWindow}
+}
