{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The deploy passes --name crm-web-<env> (environmentAwareWorkerName).
  "name": "crm-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request first: it redirects the bare domain to
    // www and marks the non-public hosts noindex (worker/index.js).
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
