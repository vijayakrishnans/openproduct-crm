// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from AWS Secrets Manager at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "openproduct-crm-identity-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  // Free plan caps a Worker at 3MB gzipped (10MB on paid) — minify fleet-wide
  // so the ceiling is never the thing that blocks a deploy.
  "minify": true,
  // Sign-in with Google and GitHub:
  //   - Nothing about a provider is stored here. On stage and prod its client
  //     id and client secret both come from Orunbase secrets (see
  //     optionalSecretEnv in component.yaml), per environment:
  //       GITHUB_OAUTH_CLIENT_ID   GITHUB_OAUTH_CLIENT_SECRET
  //       GOOGLE_OAUTH_CLIENT_ID   GOOGLE_OAUTH_CLIENT_SECRET
  //       OAUTH_STATE_SECRET       (any random string of 16+ characters)
  //     A provider is offered once its id, its secret and the state secret
  //     are all set and this worker has been redeployed.
  //   - Each OAuth app's authorized redirect/callback URL must be:
  //       {OAUTH_REDIRECT_BASE_URL}/v1/auth/oauth/{github|google}/callback
  //   - OAUTH_ALLOWED_CONSOLE_ORIGINS lists the sites a sign-in may return to:
  //     the CRM web app (custom domain and workers.dev) and the console.
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY": "true",
    "GITHUB_OAUTH_CLIENT_ID": "",
    "GOOGLE_OAUTH_CLIENT_ID": "",
    "OAUTH_REDIRECT_BASE_URL": "http://localhost:8787",
    "OAUTH_ALLOWED_CONSOLE_ORIGINS": "http://localhost:3000",
    "SOLO_MODE": "false"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY": "true",
        "GITHUB_OAUTH_CLIENT_ID": "",
        "GOOGLE_OAUTH_CLIENT_ID": "",
        "OAUTH_REDIRECT_BASE_URL": "",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://openproduct-crm-web-console-next-dev.vijayakrishnan12994.workers.dev",
        "SOLO_MODE": "false"
      }
    },
    "stage": {
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY": "true",
        "OAUTH_REDIRECT_BASE_URL": "https://openproduct-crm-api-edge-stage.vijayakrishnan12994.workers.dev",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://stage.brokecrm.cloud,https://openproduct-crm-crm-web-stage.vijayakrishnan12994.workers.dev,https://openproduct-crm-web-console-next-stage.vijayakrishnan12994.workers.dev",
        "SOLO_MODE": "false"
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/stage:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "openproduct-crm-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "openproduct-crm-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "openproduct-crm-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY": "false",
        "OAUTH_REDIRECT_BASE_URL": "https://openproduct-crm-api-edge-prod.vijayakrishnan12994.workers.dev",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://www.brokecrm.cloud,https://openproduct-crm-crm-web-prod.vijayakrishnan12994.workers.dev,https://openproduct-crm-web-console-next-prod.vijayakrishnan12994.workers.dev",
        "SOLO_MODE": "false"
      },
      "hyperdrive": [
        {
          "binding": "PLATFORM_DB",
          "id": "@@wiring(cloudflare-hyperdrive/prod:hyperdrive_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "openproduct-crm-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "openproduct-crm-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "openproduct-crm-notifications-worker-prod"
        }
      ]
    }
  }
}
